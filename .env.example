# NewsWeaver/.env.example
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 드라이버로 psycopg 3을 쓰므로 +psycopg를 명시해야 한다
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_RECIPIENT=