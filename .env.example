# NewsWeaver/.env.example
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 쪽 포트. 비워 두면 docker-compose가 5432를 쓴다
# POSTGRES_PORT=5432

# 드라이버로 psycopg 3을 쓰므로 +psycopg를 명시해야 한다
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# 임베딩 모델과 차원. 차원은 db/tables.py의 EMBEDDING_DIMENSION(벡터 컬럼)과
# 같아야 하며, 다르면 시작 시점에 실패한다
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768

# 이 값 이상이면 같은 사건으로 본다. 모델마다 유사도 분포가 달라
# scripts/spike_check_dedupe.py로 확인해 조정한다
DUPLICATE_SIMILARITY_THRESHOLD=0.6

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_RECIPIENT=